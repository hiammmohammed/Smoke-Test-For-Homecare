{
  "name": "phlebotex-smoke-suite",
  "private": true,
  "description": "Quick smoke tests of the Phlebotex dashboard (run after every new build).",
  "scripts": {
    "smoke": "playwright test",
    "smoke:headed": "playwright test --headed",
    "smoke:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install-browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.6.0",
    "dotenv": "18.0.6",
    "typescript": "5.8.3"
  }
}
